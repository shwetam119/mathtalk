# ============================================================
# MathTalk — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` and NEVER put secrets in frontend code.
# All secrets stay server-side.
# ============================================================

# ---------- backend server ------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8020
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Rime TTS (primary speech output) -------------------
# Required for real Rime speech. Get a key at https://rime.ai
# (API Tokens page). Without it, MathTalk uses a clearly-labelled
# browser-speech fallback.
RIME_API_KEY=
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_SPEAKER=celeste
RIME_MODEL_ID=coda

# ---------- Qdrant learner memory ------------------------------
# Required for the real Qdrant integration (e.g. http://localhost:6333).
# Without it, MathTalk uses a file-backed local vector store with the
# same interface. The demo behaviour is identical either way.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mathtalk_learner_memory

# ---------- LLM (Gemma / OpenAI-compatible) ---------------------
# Optional. Leave empty to run the deterministic reasoning engine.
# Gemma 4 integration (recommended): the model answers through an
# OpenAI-compatible endpoint. Set GEMMA_MODEL to your deployment id
# (e.g. a Gemma 4 served via Ollama / vLLM / Google AI Studio).
# LLM_PROVIDER=gemma
# GEMMA_API_KEY=
# GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMMA_MODEL=gemma-3-27b-it
#
# Generic OpenAI-compatible endpoint alternative:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
#
# Route tutor response wording through the LLM when it is configured
# (deterministic messages remain the safety net either way).
# LLM_USE_FOR_RESPONSES=true

# ---------- Server-side speech-to-text (optional) ---------------
# Leave empty to use the browser Web Speech API (recommended, no key).
# STT_PROVIDER=openai_compatible
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

# ---------- tutoring / demo --------------------------------------
DEMO_STUDENT_ID=demo-student-001
CONFIRM_MODE_SELECTION=true
MAX_ATTEMPTS_BEFORE_SOLUTION=3
